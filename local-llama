#!/bin/bash

# ------------------------------------------------------------------------------------------------------
# Configuration
# ------------------------------------------------------------------------------------------------------
MODEL_PATH=""
LLAMA_EXECUTABLE=""

CONTEXT_SIZE=4096      # Reasonable default context size

CUSTOM_INSTRUCTION="You are LLaMA 3.2 3B running locally. Please respond clearly and concisely."
# ------------------------------------------------------------------------------------------------------

# Check if model and executable exist
if [[ ! -f "$MODEL_PATH" ]]; then
  echo "Error: Model file not found at $MODEL_PATH"
  exit 1
fi

if [[ ! -x "$LLAMA_EXECUTABLE" ]]; then
  echo "Error: LLaMA executable not found or not executable at $LLAMA_EXECUTABLE"
  exit 1
fi

# Start interactive mode
PROMPT_TEMPLATE="[INST] <<SYS>>\n$CUSTOM_INSTRUCTION\n<</SYS>>\n\n"

# Run the model in interactive mode
"$LLAMA_EXECUTABLE" -m "$MODEL_PATH" -c "$CONTEXT_SIZE" --no-warmup --interactive -cnv
